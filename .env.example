# Copy to .env for docker compose and local runs. Never commit .env.

# Token signing uses an RSA key pair: run infra/keys/generate-dev-keys.sh to create
# infra/keys/jwt-private.pem. Only identity-service reads it; others fetch the public key (JWKS).

# AES-256 key (base64 of 32 bytes) that encrypts authenticator-app secrets at rest.
# The key script prints one, or: openssl rand -base64 32
MFA_ENCRYPTION_KEY=

# Filled in by infra/keys/rotate-signing-key.sh for the minutes after a key rotation; empty otherwise.
JWT_PREVIOUS_PUBLIC_KEYS=

# First admin account, created on identity-service startup if it does not exist.
# It must enroll an authenticator app before admin actions work.
BOOTSTRAP_ADMIN_EMAIL=admin@bigbazaar.local
BOOTSTRAP_ADMIN_PASSWORD=change-me-Admin123

# Signs the upload/download links of the local document store (base64, 32 bytes). Empty = random per
# start, which breaks links issued before a restart. Set STORAGE_PROVIDER=s3 and the S3_* values for S3.
STORAGE_SIGNING_KEY=

# Automatic seller verification. mock = built-in test registry. For real checks set sandbox and the
# keys from https://console.sandbox.co.in (test keys work against test-api.sandbox.co.in).
KYC_PROVIDER=mock
SANDBOX_API_KEY=
SANDBOX_API_SECRET=

POSTGRES_USER=bigbazaar
POSTGRES_PASSWORD=bigbazaar_dev
CORS_ALLOWED_ORIGINS=http://localhost:5173
