flowchart LR
  ID["Identity"] --> T1[["identity-events<br/>→ Catalog (seller projection), Notification"]]
  CAT["Catalog"] --> T2[["product-events<br/>→ Commerce (product projection), Search, Recommendation"]]
  COM["Commerce"] --> T3[["commerce-events<br/>→ Payment, Fulfillment, Trust, Search, Recommendation, Notification"]]
  PAY["Payment"] --> T4[["payment-events<br/>→ Commerce (confirm or release), Fulfillment, Notification"]]
  FUL["Fulfillment"] --> T5[["fulfillment-events<br/>→ Commerce, Payment (holds, refunds), Trust, Notification"]]
  TR["Trust"] --> T6[["trust-events<br/>→ Catalog, Search, Recommendation"]]
  REC["Recommendation"] --> T7[["recommendation-events<br/>→ Recommendation (activity)"]]
  NOT["Notification"] --> T8[["notification-events<br/>→ delivery history"]]
  T1 & T2 & T3 & T4 & T5 & T6 & T7 & T8 --> ALL["Insights and Audit<br/>consume every topic"]
